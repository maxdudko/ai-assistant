# Copy this file to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars to git — it contains secrets.

# ── Vercel ────────────────────────────────────────────────────
# Get from: https://vercel.com/account/tokens
vercel_api_token = "your-vercel-api-token"

# Your Vercel team slug (leave empty for personal account)
vercel_team_id = ""

# ── GitHub ────────────────────────────────────────────────────
github_repo              = "your-github-username/ai-assistant"
github_production_branch = "main"

# ── Neon ──────────────────────────────────────────────────────
# Get from: https://console.neon.tech/app/settings/api-keys
neon_api_key = "your-neon-api-key"

# Available regions: aws-us-east-1, aws-us-east-2, aws-us-west-2,
#                    aws-eu-central-1, aws-ap-southeast-1
neon_region = "aws-us-east-1"

# ── App secrets ───────────────────────────────────────────────
jwt_secret     = "change-me-use-openssl-rand-hex-64"
openai_api_key = "sk-your-openai-key"
gemini_api_key = ""   # optional
news_api_key   = ""   # optional — NewsAPI.org

# ── AI / embedding ────────────────────────────────────────────
embedding_dim      = 3072          # text-embedding-3-large
ollama_url         = ""            # e.g. https://your-ollama-host — leave empty in prod
ollama_model       = "llama3.2:latest"
ollama_embed_model = "nomic-embed-text:latest"

# ── Misc ──────────────────────────────────────────────────────
app_name = "PMA_API"
