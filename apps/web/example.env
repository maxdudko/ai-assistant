# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public landing-page contact links (leave empty to hide a button)
NEXT_PUBLIC_CONTACT_LANDING_URL=
NEXT_PUBLIC_CONTACT_LINKEDIN_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GITHUB_URL=

# PWA push notifications are configured on the API service:
# VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT in apps/api/.env
