# App
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pma
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/pma

# AI
# LLM_PROVIDER can be set to 'ollama' or 'openai' to switch between providers
LLM_PROVIDER=ollama
# Optional: override embeddings backend independently (ollama | openai)
# EMBEDDINGS_PROVIDER=ollama

OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBED_MODEL=text-embedding-3-large
GEMINI_API_KEY=your-key

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
EMBEDDING_DIM=3072

# Auth
JWT_SECRET=dev-jwt-secret-change-in-production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Internal
APP_NAME=PMA_API

NEWS_API_KEY=news-api-key-placeholder

# Stripe (optional — billing disabled when any value is missing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Local dev: run on the HOST (not inside Docker):
#   stripe listen --forward-to localhost:4000/api/subscriptions/webhook
# Use the whsec_... printed by the CLI here — NOT the Dashboard webhook secret.
STRIPE_PRO_PRICE_ID=price_...  # Price ID (price_...), NOT Product ID (prod_...)
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/me/subscription?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/me/subscription?checkout=canceled
STRIPE_BILLING_PORTAL_RETURN_URL=http://localhost:3000/me/subscription
