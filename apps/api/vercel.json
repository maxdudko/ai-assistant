{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "includeFiles": [
          "dist/**",
          "prisma/schema.prisma",
          "node_modules/.prisma/**",
          "node_modules/@prisma/client/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/scheduler/morning-briefing",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/scheduler/evening-reflection",
      "schedule": "0 20 * * *"
    }
  ]
}
