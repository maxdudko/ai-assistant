// ================================
// Generator & Datasource
// ================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================
// Enums
// ================================

enum Tone {
  Neutral
  Friendly
  Professional
  Casual
  Humorous
  Empathetic
}

enum Verbosity {
  Short
  Medium
  Detailed
}

enum ConversationMode {
  MANAGER
  REFLECTION
  COMPANION
  INFO
}

enum ConversationState {
  CREATED
  ACTIVE
  ARCHIVED
}

enum ConversationType {
  DAILY
  AD_HOC
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskSource {
  CHAT
  MANUAL
}

enum GoalType {
  SHORT
  MIDDLE
  LONG
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
}

enum GoalSource {
  CHAT
  MANUAL
}

enum DayState {
  START
  ACTIVE
  END
}

enum MemoryType {
  FACTUAL
  REFLECTION
}

enum MemorySource {
  CONVERSATION
  REFLECTION
  ONBOARDING
}

enum DigestFrequency {
  DAILY
}

// ================================
// Models
// ================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  refreshTokenHash String?
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile             UserProfile?
  conversations       Conversation[]
  tasks               Task[]
  goals               Goal[]
  days                Day[]
  actionCandidates    ActionCandidate[]
  actionExecutionLogs ActionExecutionLog[]
  memories            Memory[]
  digestSubscriptions DigestSubscription[]
}

model UserProfile {
  id          String @id @default(uuid())
  userId      String @unique
  displayName String @default("User")

  tone      String  @default("neutral") // 'neutral' | 'friendly' | 'professional' | 'casual' | 'humorous' | 'empathetic'
  verbosity String  @default("normal") // 'short' | 'normal' | 'detailed'
  useEmoji  Boolean @default(true)

  // Onboarding fields
  primaryUseCase        String?  // 'day-planning' | 'task-tracking' | 'reflection' | 'mixed'
  helpStyle            String?  // 'active' | 'passive'
  dayPlanningTime      String?  // 'morning' | 'evening' | 'anytime'
  reflectionTime       String?  // 'morning' | 'evening' | 'anytime'
  onboardingCompleted  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id     String            @id @default(uuid())
  userId String
  dayId  String?
  mode   ConversationMode  @default(MANAGER)
  state  ConversationState @default(CREATED)
  type   ConversationType  @default(DAILY)
  date   DateTime          @default(now()) // Date for daily conversations (start of day)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  day              Day?              @relation(fields: [dayId], references: [id], onDelete: SetNull)
  messages         Message[]
  memories         Memory[]
  tasks            Task[]            @relation("ConversationTasks")
  goals            Goal[]            @relation("ConversationGoals")
  actionCandidates ActionCandidate[]

  @@unique([userId, type, date]) // One daily conversation per user per day
  @@index([userId, state, type])
  @@index([dayId])
}

model Message {
  id             String            @id @default(uuid())
  conversationId String

  role    MessageRole
  content String
  mode    ConversationMode @default(MANAGER)

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Memory {
  id             String       @id @default(uuid())
  userId         String
  type           MemoryType   @default(FACTUAL)
  content        String
  importance     Int          @default(5) // 1..10
  tags           String[]
  source         MemorySource @default(CONVERSATION)
  dayId          String?
  conversationId String?

  embedding Unsupported("vector(1536)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  day          Day?          @relation(fields: [dayId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])

  @@index([userId, type])
  @@index([userId, importance])
}

model ActionCandidate {
  id                   String   @id @default(uuid())
  userId               String
  conversationId       String?
  type                 String
  payload              Json
  confidence           Float
  requiresConfirmation Boolean  @default(true)
  status               String   @default("PENDING")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  logs         ActionExecutionLog[]

  @@index([userId, createdAt])
  @@index([conversationId])
  @@index([status])
}

model ActionExecutionLog {
  id        String   @id @default(uuid())
  actionId  String?
  userId    String
  type      String
  payload   Json
  status    String
  error     String?
  createdAt DateTime @default(now())

  action ActionCandidate? @relation(fields: [actionId], references: [id], onDelete: SetNull)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([actionId])
}

model Task {
  id             String       @id @default(uuid())
  userId         String
  dayId          String?
  name           String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  deadline       DateTime?
  source         TaskSource   @default(MANUAL)
  conversationId String?
  parentId       String?
  goalId         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  day          Day?          @relation(fields: [dayId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation("ConversationTasks", fields: [conversationId], references: [id], onDelete: SetNull)
  parent       Task?         @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks     Task[]        @relation("TaskHierarchy")
  goal         Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([dayId])
  @@index([conversationId])
  @@index([parentId])
  @@index([goalId])
}

model Goal {
  id             String       @id @default(uuid())
  userId         String
  name           String
  description    String?
  type           GoalType     @default(SHORT)
  priority       GoalPriority @default(MEDIUM)
  isAchieved     Boolean      @default(false)
  source         GoalSource   @default(MANUAL)
  conversationId String?
  parentId       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation("ConversationGoals", fields: [conversationId], references: [id], onDelete: SetNull)
  parent       Goal?         @relation("GoalHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subgoals     Goal[]        @relation("GoalHierarchy")
  tasks        Task[]

  @@index([userId, isAchieved])
  @@index([userId, createdAt])
  @@index([conversationId])
  @@index([parentId])
}

model Day {
  id        String    @id @default(uuid())
  userId    String
  date      DateTime
  state     DayState  @default(START)
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks         Task[]
  conversations Conversation[]
  memories      Memory[]

  @@unique([userId, date])
  @@index([userId, date])
  @@index([userId, state])
}

model DigestTopic {
  id             String   @id @default(uuid())
  name           String
  normalizedName String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions DigestSubscription[]
}

model DigestSubscription {
  id        String          @id @default(uuid())
  userId    String
  topicId   String
  frequency DigestFrequency @default(DAILY)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic DigestTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, frequency])
}
