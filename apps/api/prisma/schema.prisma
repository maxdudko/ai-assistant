// ================================
// Generator & Datasource
// ================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ================================
// Enums
// ================================

enum ConversationMode {
  MANAGER
  REFLECTION
  COMPANION
  INFO
}

enum ConversationState {
  CREATED
  ACTIVE
  ARCHIVED
}

enum ConversationType {
  DAILY
  AD_HOC
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ================================
// Models
// ================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile       UserProfile?
  conversations Conversation[]
}

model UserProfile {
  id          String @id @default(uuid())
  userId      String @unique
  displayName String @default("User")

  tone      String  @default("neutral")
  verbosity String  @default("medium")
  useEmoji  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id     String            @id @default(uuid())
  userId String
  mode   ConversationMode  @default(MANAGER)
  state  ConversationState @default(CREATED)
  type   ConversationType  @default(DAILY)
  date   DateTime          @default(now()) // Date for daily conversations (start of day)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  memories Memory[]

  @@unique([userId, type, date]) // One daily conversation per user per day
  @@index([userId, state, type])
}

model Message {
  id             String @id @default(uuid())
  conversationId String

  role    MessageRole
  content String

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Memory {
  id             String  @id @default(uuid())
  conversationId String
  userId         String

  content     String
  importance  Int      @default(5) // 1-10 scale
  tags        String[] // For categorization

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([conversationId])
}
