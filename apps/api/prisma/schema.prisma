// ================================
// Generator & Datasource
// ================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled URL (PgBouncer) — used by the running app
  url       = env("DATABASE_URL")
  // Direct URL — used by prisma migrate deploy (DDL requires a direct connection)
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ================================
// Enums
// ================================

enum Tone {
  Neutral
  Friendly
  Professional
  Casual
  Humorous
  Empathetic
}

enum Verbosity {
  Short
  Medium
  Detailed
}

enum ConversationMode {
  MANAGER
  REFLECTION
  COMPANION
  INFO
}

enum ConversationState {
  CREATED
  ACTIVE
  ARCHIVED
}

enum ConversationType {
  DAILY
  AD_HOC
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskSource {
  CHAT
  MANUAL
}

enum GoalType {
  SHORT
  MIDDLE
  LONG
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
}

enum GoalSource {
  CHAT
  MANUAL
}

enum DayState {
  START
  ACTIVE
  END
}

enum DayPhase {
  NOT_STARTED
  MORNING
  PLANNING
  EXECUTION
  EVENING
  CLOSED
}

enum NudgeType {
  MORNING_START
  PLAN_OVERLOAD
  NO_PROGRESS
  STUCK_TASK
  EVENING_REFLECTION
}

enum NudgePriority {
  LOW
  MEDIUM
  HIGH
}

enum MemoryType {
  FACTUAL
  REFLECTION
}

enum MemorySource {
  CONVERSATION
  REFLECTION
  ONBOARDING
}

enum MemoryLayer {
  EPISODIC
  SEMANTIC
  PATTERN
}

enum DigestFrequency {
  DAILY
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum PaymentStatus {
  PAID
  OPEN
  FAILED
  VOID
  UNCOLLECTIBLE
}

enum SubscriptionEventType {
  SUBSCRIBED
  RENEWED
  UPDATED
  CANCELED
  PAYMENT_FAILED
  DOWNGRADED
}

enum Feature {
  ADVANCED_INSIGHTS
  TRUTHLENS
  CROSS_WEEK_ANALYSIS
}

enum NotificationType {
  MORNING_BRIEFING
  EVENING_REFLECTION
  NUDGE
  WEEKLY_INSIGHT
  SYSTEM
}

enum PushPlatform {
  WEB
}

// ================================
// Models
// ================================

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String
  refreshTokenHash     String?
  tokenVersion         Int       @default(0)
  passwordResetToken   String?
  passwordResetExpires DateTime?
  suspendedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  profile             UserProfile?
  conversations       Conversation[]
  tasks               Task[]
  goals               Goal[]
  days                Day[]
  dayInsights         DayInsight[]
  nudgeEvents         NudgeEvent[]
  actionCandidates    ActionCandidate[]
  actionExecutionLogs ActionExecutionLog[]
  memories            Memory[]
  digestSubscriptions DigestSubscription[]
  aiLogs              AiLog[]
  weeklyInsights      WeeklyInsight[]
  subscription        Subscription?
  paymentRecords      PaymentRecord[]
  subscriptionEvents      SubscriptionEvent[]
  featureOverrides        UserFeatureOverride[]
  notificationPreference  NotificationPreference?
  pushSubscriptions       PushSubscription[]
  notifications           Notification[]
}

model Admin {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  refreshTokenHash String?
  tokenVersion     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model UserProfile {
  id          String @id @default(uuid())
  userId      String @unique
  displayName String @default("User")

  tone      String  @default("neutral") // 'neutral' | 'friendly' | 'professional' | 'casual' | 'humorous' | 'empathetic'
  verbosity String  @default("normal") // 'short' | 'normal' | 'detailed'
  useEmoji  Boolean @default(true)

  // Onboarding fields
  primaryUseCase      String? // 'day-planning' | 'task-tracking' | 'reflection' | 'mixed'
  helpStyle           String? // 'active' | 'passive'
  dayPlanningTime     String? // 'morning' | 'evening' | 'anytime'
  reflectionTime      String? // 'morning' | 'evening' | 'anytime'
  timezone            String  @default("UTC")
  onboardingCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id                       String  @id @default(uuid())
  userId                   String  @unique
  pushEnabled              Boolean @default(true)
  morningBriefingEnabled   Boolean @default(true)
  eveningReflectionEnabled Boolean @default(true)
  nudgesEnabled            Boolean @default(true)
  weeklyInsightEnabled     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String       @id @default(uuid())
  userId    String
  platform  PushPlatform @default(WEB)
  endpoint  String       @unique
  p256dh    String
  auth      String
  userAgent String?
  lastUsedAt DateTime    @default(now())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id             String           @id @default(uuid())
  userId         String
  type           NotificationType
  title          String
  body           String
  deepLink       String?
  conversationId String?
  messageId      String?
  dayId          String?
  dedupeKey      String?
  readAt         DateTime?
  pushedAt       DateTime?
  pushError      String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

model Conversation {
  id     String            @id @default(uuid())
  userId String
  dayId  String?
  mode   ConversationMode  @default(MANAGER)
  state  ConversationState @default(CREATED)
  type   ConversationType  @default(DAILY)
  date   DateTime          @default(now()) // Date for daily conversations (start of day)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  day              Day?              @relation(fields: [dayId], references: [id], onDelete: SetNull)
  messages         Message[]
  memories         Memory[]
  tasks            Task[]            @relation("ConversationTasks")
  goals            Goal[]            @relation("ConversationGoals")
  actionCandidates ActionCandidate[]

  @@unique([userId, type, date]) // One daily conversation per user per day
  @@index([userId, state, type])
  @@index([dayId])
}

model Message {
  id             String @id @default(uuid())
  conversationId String

  role    MessageRole
  content String
  mode    ConversationMode @default(MANAGER)

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Memory {
  id             String       @id @default(uuid())
  userId         String
  type           MemoryType   @default(FACTUAL)
  layer          MemoryLayer  @default(SEMANTIC)
  content        String
  importance     Int          @default(5) // 1..10
  confidence     Float        @default(0.8)
  tags           String[]
  source         MemorySource @default(CONVERSATION)
  usageCount     Int          @default(0)
  lastUsedAt     DateTime?
  dayId          String?
  conversationId String?

  embedding Unsupported("vector(3072)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  day          Day?          @relation(fields: [dayId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([userId, layer])
  @@index([userId, importance])
  @@index([userId, createdAt])
}

model ActionCandidate {
  id                   String   @id @default(uuid())
  userId               String
  conversationId       String?
  type                 String
  payload              Json
  confidence           Float
  requiresConfirmation Boolean  @default(true)
  status               String   @default("PENDING")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  logs         ActionExecutionLog[]

  @@index([userId, createdAt])
  @@index([conversationId])
  @@index([status])
}

model WeeklyInsight {
  id             String   @id @default(uuid())
  userId         String
  weekStart      DateTime // Monday 00:00 in user's timezone, stored as UTC instant
  weekEnd        DateTime // Sunday 23:59:59.999 in user's timezone, stored as UTC instant
  isoYear        Int
  isoWeek        Int
  score          Int // 1..10 aggregate week score
  completionRate Float
  totalTasks     Int      @default(0)
  completedTasks Int      @default(0)
  reschedules    Int      @default(0)
  topPatterns    String[] @default([])
  focusSuggestion String?
  narrative      String   @db.Text
  source         String   @default("AUTOMATIC") // AUTOMATIC | MANUAL
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, isoYear, isoWeek])
  @@index([userId, weekStart])
}

model ActionExecutionLog {
  id        String   @id @default(uuid())
  actionId  String?
  userId    String
  type      String
  payload   Json
  status    String
  error     String?
  reversible Boolean @default(false)
  undoPayload Json?
  createdAt DateTime @default(now())

  action ActionCandidate? @relation(fields: [actionId], references: [id], onDelete: SetNull)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([actionId])
}

model Task {
  id               String       @id @default(uuid())
  userId           String
  dayId            String?
  name             String
  description      String?
  status           TaskStatus   @default(TODO)
  priority         TaskPriority @default(MEDIUM)
  difficulty       Int          @default(3)
  estimatedMinutes Int?
  deadline         DateTime?
  source           TaskSource   @default(MANUAL)
  conversationId   String?
  parentId         String?
  goalId           String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  day          Day?          @relation(fields: [dayId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation("ConversationTasks", fields: [conversationId], references: [id], onDelete: SetNull)
  parent       Task?         @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks     Task[]        @relation("TaskHierarchy")
  goal         Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([dayId])
  @@index([conversationId])
  @@index([parentId])
  @@index([goalId])
}

model Goal {
  id             String       @id @default(uuid())
  userId         String
  name           String
  description    String?
  type           GoalType     @default(SHORT)
  priority       GoalPriority @default(MEDIUM)
  isAchieved     Boolean      @default(false)
  source         GoalSource   @default(MANUAL)
  conversationId String?
  parentId       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation("ConversationGoals", fields: [conversationId], references: [id], onDelete: SetNull)
  parent       Goal?         @relation("GoalHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subgoals     Goal[]        @relation("GoalHierarchy")
  tasks        Task[]

  @@index([userId, isAchieved])
  @@index([userId, createdAt])
  @@index([conversationId])
  @@index([parentId])
}

model Day {
  id             String    @id @default(uuid())
  userId         String
  date           DateTime
  state          DayState  @default(START)
  phase          DayPhase  @default(NOT_STARTED)
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime  @default(now())
  lastActivityAt DateTime?

  morningBriefingSentAt    DateTime?
  eveningReflectionSentAt  DateTime?
  planningSuggestionSentAt DateTime?
  noProgressNudgeSentAt    DateTime?
  stuckTaskNudgeSentAt     DateTime?
  nudgesSentCount          Int       @default(0)
  nudgesSentToday          Int       @default(0)
  lastNudgeAt              DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks         Task[]
  conversations Conversation[]
  memories      Memory[]
  insight       DayInsight?
  nudgeEvents   NudgeEvent[]

  @@unique([userId, date])
  @@index([userId, date])
  @@index([userId, state])
  @@index([userId, phase])
}

model DayInsight {
  id             String   @id @default(uuid())
  dayId          String   @unique
  userId         String
  score          Int
  completionRate Float
  consistency    Float
  focus          Float
  summary        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  day  Day  @relation(fields: [dayId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model NudgeEvent {
  id        String        @id @default(uuid())
  userId    String
  dayId     String
  type      NudgeType
  priority  NudgePriority
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  day  Day  @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
  @@index([dayId, type, createdAt])
}

model DigestTopic {
  id             String   @id @default(uuid())
  name           String
  normalizedName String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions DigestSubscription[]
}

model DigestSubscription {
  id        String          @id @default(uuid())
  userId    String
  topicId   String
  frequency DigestFrequency @default(DAILY)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic DigestTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, frequency])
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  plan                 SubscriptionPlan     @default(FREE)
  status               SubscriptionStatus   @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  trialEnd             DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([plan])
}

model UserFeatureOverride {
  id        String   @id @default(uuid())
  userId    String
  feature   Feature
  allowed   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature])
  @@index([userId])
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
  payload     Json?
}

model PaymentRecord {
  id                String        @id @default(uuid())
  userId            String
  stripeInvoiceId   String        @unique
  amountCents       Int
  currency          String        @default("usd")
  status            PaymentStatus
  description       String?
  invoiceNumber     String?
  hostedInvoiceUrl  String?
  invoicePdfUrl     String?
  paidAt            DateTime?
  periodStart       DateTime?
  periodEnd         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, paidAt])
  @@index([userId, createdAt])
}

model SubscriptionEvent {
  id          String                @id @default(uuid())
  userId      String
  type        SubscriptionEventType
  plan        SubscriptionPlan?
  status      SubscriptionStatus?
  description String
  occurredAt  DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
}

model AiLog {
  id        String           @id @default(uuid())
  userId    String
  mode      ConversationMode
  prompt    String           @db.Text
  response  String           @db.Text
  actions   Json // Array of action candidates
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, mode])
}
